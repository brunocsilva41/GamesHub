# Normalize text to LF in the repository; Windows-only scripts keep CRLF in the working tree.
* text=auto eol=lf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.manifest text eol=crlf

# Binaries
*.dll   binary
*.exe   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.woff2 binary
*.zip   binary

# Keep generated/vendor files out of language stats
lib/**   linguist-vendored
